<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="edi_backend_view_form" model="ir.ui.view">
        <field name="model">edi.backend</field>
        <field name="inherit_id" ref="edi_storage_oca.edi_backend_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//group[@name='storage_config']" position="after">
                <group
                    name="storage_test_config"
                    string="Test environment"
                    invisible="not test_mode_supported"
                >
                    <field name="test_storage_id" />
                    <field name="test_input_dir_pending" />
                    <field name="test_input_dir_done" />
                    <field name="test_input_dir_error" />
                    <field name="test_output_dir_pending" />
                    <field name="test_output_dir_done" />
                    <field name="test_output_dir_error" />
                </group>
            </xpath>
        </field>
    </record>
</odoo>
