<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="edi_backend_type_view_tree" model="ir.ui.view">
        <field name="model">edi.backend.type</field>
        <field name="inherit_id" ref="edi_core_oca.edi_backend_type_view_tree" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='code']" position="after">
                <field name="test_mode_supported" />
            </xpath>
        </field>
    </record>
    <record id="edi_backend_type_view_form" model="ir.ui.view">
        <field name="model">edi.backend.type</field>
        <field name="inherit_id" ref="edi_core_oca.edi_backend_type_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='code']" position="after">
                <field name="test_mode_supported" />
            </xpath>
        </field>
    </record>
</odoo>
